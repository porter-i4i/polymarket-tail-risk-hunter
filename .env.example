# =============================================================================
# Polymarket Tail Risk Hunter — Environment Configuration
# Copy this file to .env and fill in your values before starting.
#
#   cp .env.example .env
#
# For a DRY RUN (paper test), leave POLYMARKET_PRIVATE_KEY empty and keep
# DRY_RUN=true.  The bot will make real API calls to Gamma + Claude but will
# NOT place any real orders.
# =============================================================================


# ---------------------------------------------------------------------------
# SECRETS — required at runtime
# ---------------------------------------------------------------------------

# Anthropic API key (Claude) — REQUIRED for scoring
ANTHROPIC_API_KEY=

# Telegram bot token + chat ID — REQUIRED for alerts
# Create a bot via @BotFather and get the chat ID via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News API key (newsapi.org or compatible) — leave empty to disable news signals
NEWS_API_KEY=

# Polymarket Polygon wallet private key — leave EMPTY for dry-run mode
# Export via MetaMask: Account menu → Export Private Key
# Format: hex string WITHOUT 0x prefix
POLYMARKET_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# OPERATING MODE
# ---------------------------------------------------------------------------

# true  = dry run (no real orders placed, wallet not needed)
# false = live trading (requires POLYMARKET_PRIVATE_KEY)
DRY_RUN=true

# Seconds between each main loop cycle (min 10, max 600)
CYCLE_INTERVAL_SECONDS=60


# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# SQLite path (relative to repo root)
DB_PATH=data/polybot.db


# ---------------------------------------------------------------------------
# MARKET SCANNING
# ---------------------------------------------------------------------------

# Maximum YES token price to consider (e.g. 0.05 = max 5¢ / 5% implied prob)
MAX_PRICE_THRESHOLD=0.05

# Minimum 24-hour volume in USD
MIN_VOLUME_24H=100

# Minimum order-book liquidity in USD
MIN_LIQUIDITY=500


# ---------------------------------------------------------------------------
# RISK MANAGEMENT
# ---------------------------------------------------------------------------

# Total bankroll in USD (for Kelly sizing and drawdown calculations)
TOTAL_BANKROLL=1000

# Maximum concurrent open positions
MAX_OPEN_POSITIONS=200

# Maximum fraction of bankroll in a single category (0.15 = 15%)
MAX_CATEGORY_PCT=0.15

# Maximum drawdown from peak before circuit breaker trips (0.30 = 30%)
MAX_DRAWDOWN_PCT=0.30

# Minimum AI confidence score to consider a bet (0–100)
MIN_AI_CONFIDENCE=60

# Minimum edge percentage over market price required
MIN_EDGE_PCT=2.0

# Minimum expected value (probability units)
MIN_EV=0.03


# ---------------------------------------------------------------------------
# PHASE 1 — Calibration phase (low flat bets, data collection)
# ---------------------------------------------------------------------------

PHASE1_MAX_DAILY_SPEND=20
PHASE1_MAX_SINGLE_BET=2
PHASE1_MAX_BETS_PER_DAY=15
PHASE1_FLAT_BET=1.5


# ---------------------------------------------------------------------------
# PHASE 2 — Scaled phase (Kelly-sized bets once calibrated)
# ---------------------------------------------------------------------------

PHASE2_MAX_DAILY_SPEND=60
PHASE2_MAX_SINGLE_BET=25
PHASE2_MAX_BETS_PER_DAY=25
PHASE2_KELLY_FRACTION=0.25


# ---------------------------------------------------------------------------
# PHASE 3 — Full phase (higher Kelly fraction, larger positions)
# ---------------------------------------------------------------------------

PHASE3_DAILY_SPEND_PCT=0.10
PHASE3_MAX_SINGLE_BET=50
PHASE3_MAX_BETS_PER_DAY=30
PHASE3_KELLY_FRACTION=0.50


# ---------------------------------------------------------------------------
# CALIBRATION & DEBIASING
# ---------------------------------------------------------------------------

# platt = Platt scaling (recommended); isotonic = IsotonicRegression fallback
CALIBRATION_METHOD=platt

# Minimum resolved predictions needed before Platt fitting begins
CALIBRATION_MIN_SAMPLES=100

# Retrain calibrator every N new resolved predictions
CALIBRATION_RETRAIN_EVERY=50

# Use conservative p10 estimate for Kelly sizing (recommended)
USE_CONSERVATIVE_ESTIMATE=true

# Scoring cache TTL in seconds (1800 = 30 minutes)
SCORING_CACHE_DEFAULT_TTL=1800

# Minimum resolved predictions to graduate to Phase 2 / Phase 3
MIN_PREDICTIONS_PHASE2=200
MIN_PREDICTIONS_PHASE3=500

# Minimum calibration score CI lower bound required for phase graduation
MIN_CAL_SCORE_PHASE2=0.60
MIN_CAL_SCORE_PHASE3=0.65

# Circuit breaker: halt if N consecutive loss days (default 7-day window)
CIRCUIT_BREAKER_DAYS=7
CIRCUIT_BREAKER_LOSS_PCT=0.15


# ---------------------------------------------------------------------------
# ADVERSE SELECTION DETECTION
# ---------------------------------------------------------------------------

TOXICITY_THRESHOLD=0.50
VOLUME_SPIKE_THRESHOLD=3.0
BOOK_IMBALANCE_THRESHOLD=0.70
MIN_BOOK_DEPTH=200
MAX_SPREAD_PCT=0.50


# ---------------------------------------------------------------------------
# EXIT STRATEGY
# ---------------------------------------------------------------------------

# Exit when price reaches entry × this multiple (take-profit)
EXIT_PROFIT_MULTIPLIER=3.0

# Exit positions older than N hours if no resolution
EXIT_TIME_DECAY_HOURS=24

# Stop-loss: exit if position value falls to this fraction of cost
EXIT_STOP_LOSS_PCT=0.70


# ---------------------------------------------------------------------------
# CORRELATION CLUSTERING
# ---------------------------------------------------------------------------

MAX_CLUSTER_EXPOSURE_PCT=0.20
SIMILARITY_THRESHOLD=0.35


# ---------------------------------------------------------------------------
# RATE LIMITS (requests per minute per API)
# ---------------------------------------------------------------------------

GAMMA_RATE_LIMIT=80
CLOB_DATA_RATE_LIMIT=80
CLOB_ORDER_RATE_LIMIT=40
NEWS_RATE_LIMIT=12
CLAUDE_RATE_LIMIT=50


# ---------------------------------------------------------------------------
# FEATURE FLAGS — set to false to disable a module (pass-through behaviour)
# ---------------------------------------------------------------------------

ENABLE_DEBIASER=true
ENABLE_PLATT_SCALING=true
ENABLE_ADVERSE_SELECTION=true
ENABLE_ORDER_BOOK_HEALTH=true
ENABLE_EXIT_MANAGER=true
ENABLE_CORRELATION_CLUSTERS=true
ENABLE_SIGNAL_AGGREGATOR=true
ENABLE_FEE_CHECK=true
